; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="NoiseWorldGen2D"
config/description="Tilemap tool script built to make simple noise-based worlds."
run/main_scene="res://addons/NoiseWorldGen2D/src/NoiseWorldGen2D.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://Icon256.png"

[debug]

